rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPhoto(data) {
      return data.keys().hasAll(['id', 'dataUrl', 'collageType', 'templateName', 'createdAt'])
        && data.keys().hasOnly(['id', 'dataUrl', 'collageType', 'templateName', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.dataUrl is string && data.dataUrl.size() <= 30000000
        && data.collageType in ['strip', 'grid']
        && data.templateName is string && data.templateName.size() <= 120
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['id', 'title', 'dataUrl', 'collageType', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'dataUrl', 'collageType', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 100
        && data.dataUrl is string && data.dataUrl.size() <= 30000000
        && data.collageType in ['strip', 'grid']
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Connection test document
    match /test/{testId} {
      allow get: if isValidId(testId);
    }

    // Photobooth photos accessible for scanning and downloading
    match /photos/{photoId} {
      allow get: if isValidId(photoId);
      allow create: if isValidId(photoId) && isValidPhoto(request.resource.data);
      allow update, delete: if false;
    }

    // Custom frame templates (e.g. PLESIR.png)
    match /templates/{templateId} {
      allow get: if isValidId(templateId);
      allow list: if true;
      allow create, update: if isValidId(templateId) && isValidTemplate(request.resource.data);
      allow delete: if false;
    }
  }
}
